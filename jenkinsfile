pipeline{
    agent{
        label 'worker'
    }

    tools{
        maven 'mvn'
    }

    environment{
        my_aws = credentials('aws-cred')
    }
    
    stages{
        stage('checkout'){
            steps{
               git 'https://github.com/Abhisharma078/student-management.git'
               echo "clonning is successfully"
            }
        }
        stage('build'){
            steps{
                sh '''
                  mvn clean package
                  '''
            }
            post{
                success{
                    archiveArtifacts  artifacts: '**/target/*.war', fingerprint: true
                }
            }
        }

        stage('Artifacts to s3'){
            steps{
               sh ' aws s3 cp target/*.war s3://abhicloud.online/Artifacts/student.war'
            }
        }

        stage('sonarqube Analysis'){
            steps{
               withSonarQubeEnv ('sonar'){
                 mvn sonar:sonar
               }    
            }
        }

        stage('Quality Gate'){
            steps{
                timeout(time:5 , unit: 'MINUTES'){
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('docker build'){
            steps{
                sh '''
                  docker build -t student .
                  docker images
                  '''
            }
        }

        stage('Push to ECR'){
            steps{
                sh '''
                aws ecr get-login-password --region ap-south-1 | docker login --username AWS --password-stdin 822920903800.dkr.ecr.ap-south-1.amazonaws.com
                docker tag student:latest 822920903800.dkr.ecr.ap-south-1.amazonaws.com/student:latest
                docker push 822920903800.dkr.ecr.ap-south-1.amazonaws.com/student:latest
                '''
            }
        }

        stage('Deployment to k8s'){
            steps{
                sh '''
                 eksctl update-kubeconfig --name mycluster --region ap-south-1
                 kubectl apply -f k8s/
                 kubectl get pods
                 sleep 30
                 kubectl get pods
                 kubectl get svc
                 '''
            }
        }
    }
}