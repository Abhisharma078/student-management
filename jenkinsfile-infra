pipeline{
    agent{
        label 'worker'
    }

    tools{
        terraform 'tf'
    }

    stages{
        stage('checkout'){
            steps{
                git 'https://github.com/Abhisharma078/student-management.git'
                echo "checkout is success"
            }
        }

        stage('terraform init'){
            steps{
                sh 'terraform init'
            }
        }
        
        stage('terraform validate'){
            steps{
                sh 'terraform validate'
            }
        }
        stage('terraform apply'){
            steps{
                sh 'terraform apply --auto-approve'
            }
        }
    }
}
